{
  "appId": "com.cyber-agent.ide",
  "productName": "Cyber Agent IDE",
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../src/cyber_agent",
      "to": "src/cyber_agent",
      "filter": ["**/*.py"]
    }
  ],
  "linux": {
    "target": ["AppImage"],
    "category": "Development",
    "icon": "public/icon.png",
    "synopsis": "AI-Powered Cybersecurity IDE",
    "description": "Cyber Agent IDE - A modern AI-powered desktop IDE for cybersecurity."
  },
  "win": {
    "target": ["nsis"],
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  },
  "mac": {
    "target": ["dmg"],
    "icon": "public/icon.png"
  }
}
