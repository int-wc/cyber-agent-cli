# ── 模型网关 ──
GATEWAY_API_KEY=
GATEWAY_DEFAULT_MODEL=deepseek-v4-flash-free
# GATEWAY_BASE_URL=http://127.0.0.1:8317/v1
GATEWAY_DEFAULT_SERVICE=ccswitch

# ── CC-SWITCH 同步 ──
# 启用后，GATEWAY_DEFAULT_SERVICE=ccswitch 会从 ~/.cc-switch/cc-switch.db
# 全量读取可转换为 OpenAI Chat 的 provider，按协议分类、去重并自动构建 fallback 池。
CC_SWITCH_SYNC_ENABLED=true
# CC_SWITCH_DB_PATH=/home/my/.cc-switch/cc-switch.db

# ── OpenCode Zen ──
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OpenCode 必须配置代理，请按本机网络环境替换为可用地址。
OPENCODE_PROXY_URL=http://proxy.example:7892
# OPENCODE_PROXY_URL=socks://proxy.example:7892
SUBAGENT_MODEL=deepseek-v4-flash-free

# ── Anthropic 兼容 API（DeepSeek / MiMo 等支持 Anthropic 格式的服务商）──
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=

# ── DeepSeek ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=enabled

# ── MiMo ──
# MIMO_API_KEY=
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic

# ── BaiSub OpenAI 兼容 API ──
# 多个 key/model 按顺序一一对应；某个 key 不可用、限流或模型不支持时自动切下一个。
# GATEWAY_DEFAULT_SERVICE=baisub
# BAISUB_API_KEYS=primary_key,fallback_key
# BAISUB_MODELS=primary_model,fallback_model
# BAISUB_BASE_URL=https://baisub.bai.edu.kg/v1

# ── 上下文 ──
MAX_CONTEXT_CHARS=4000000
MAX_CONTEXT_TOKENS=4000000
AUTO_COMPACT_WINDOW=4000000

# ── 搜索 ──
SEARCH_SHOW_BROWSER=true
